# ─── Basis ────────────────────────────────────────────────────────────────
# Kopieer naar .env en vul in. Genereer secrets met: openssl rand -hex 32
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
# Leeg laten voor lokaal (in-memory). In productie: redis://redis:6379
REDIS_URL=
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Publieke URL van deze backend (nodig voor Mollie-webhooks, admin en productfoto's)
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# shared = server + worker in één proces (prima voor een kleine winkel)
MEDUSA_WORKER_MODE=shared

# ─── Mollie (iDEAL, Bancontact, creditcard, Apple Pay) ──────────────────────
# Testkey: Mollie dashboard > Developers > API keys (begint met test_)
MOLLIE_API_KEY=
# Waar de klant na het betalen terugkomt (route in de storefront)
MOLLIE_REDIRECT_URL=http://localhost:8000/api/mollie/return
# Staat op het bankafschrift van de klant: zet hier je winkelnaam (bv. Lichtval)
MOLLIE_DESCRIPTION=Bestelling
# true = de handmatige testbetaling blijft ook met Mollie in de checkout (alleen om te testen!)
ALLOW_TEST_PAYMENT=false

# ─── Dropshipping via CJ (leeg = uit) ───────────────────────────────────────
# Zie src/modules/cj-dropshipping/README.md. API key: CJ > My CJ > Authorization > API
CJ_API_KEY=
# false = bestelling wordt bij CJ aangemaakt, jij betaalt hem in CJ (veilig om te starten)
# true  = CJ betaalt direct van je CJ-saldo (volledig automatisch)
CJ_AUTO_PAY=false
# true = testbestellingen bij CJ (worden niet verzonden)
CJ_SANDBOX=false
# Magazijnland als een variant geen cj_from_country heeft
CJ_FROM_COUNTRY=CN
# Voorkeursverzendmethodes (komma-gescheiden), anders: goedkoopste binnen CJ_MAX_DELIVERY_DAYS
CJ_LOGISTICS=
CJ_MAX_DELIVERY_DAYS=15
CJ_ORDER_PREFIX=jit
CJ_STORE_NAME=
# true = Medusa-bestelling op 'verzonden' zetten met track & trace zodra CJ verstuurt
CJ_CREATE_FULFILLMENT=true
# Opmerking bij elke CJ-bestelling. Leeg = standaard: neutraal verpakken, geen factuur/prijzen
CJ_ORDER_REMARK=

# ─── E-mail aan klanten (bevestiging, track & trace) ──────────────────────
# Resend (resend.com) of Brevo (brevo.com). Leeg = mails worden alleen gelogd.
RESEND_API_KEY=
BREVO_API_KEY=
# Afzender op je geverifieerde domein, bv. "Lichtval <hallo@lichtval.nl>"
EMAIL_FROM=
# Waar antwoorden van klanten heen gaan (je eigen inbox)
EMAIL_REPLY_TO=
# Jij: melding bij elke bestelling + dagelijks lijstje met probleembestellingen
SHOP_OWNER_EMAIL=
# Optioneel: hetzelfde lijstje naar Discord/Slack
OPS_WEBHOOK_URL=
# Publieke URL van de winkel (links in de mails). Leeg = eerste waarde van STORE_CORS
STORE_URL=

# ─── PostHog (server-side events zoals order_completed) ────────────────────
POSTHOG_EVENTS_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Meta Conversions API (server-side Purchase). Leeg = uit. Token: Events Manager → je pixel → Settings → Conversions API.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optioneel: testcode uit Events Manager → Test events
META_TEST_EVENT_CODE=

# ─── Bootstrap (zie src/scripts/bootstrap.ts) ──────────────────────────────
# Vaste publishable key: echo pk_$(openssl rand -hex 32)
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
SEED_WAREHOUSE_CITY=Utrecht
