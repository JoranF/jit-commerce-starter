# ─── Basis ────────────────────────────────────────────────────────────────
# Kopieer naar .env en vul in. Genereer secrets met: openssl rand -hex 32
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
# Leeg laten voor lokaal (in-memory). In productie: redis://redis:6379
REDIS_URL=
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Publieke URL van deze backend (nodig voor Mollie-webhooks, admin en productfoto's)
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# shared = server + worker in één proces (prima voor een kleine winkel)
MEDUSA_WORKER_MODE=shared

# ─── Mollie (iDEAL, Bancontact, creditcard, PayPal, Apple Pay) ──────────────
# Testkey: Mollie dashboard > Developers > API keys (begint met test_)
MOLLIE_API_KEY=
# Waar de klant na het betalen terugkomt (route in de storefront)
MOLLIE_REDIRECT_URL=http://localhost:8000/api/mollie/return
MOLLIE_DESCRIPTION=Bestelling

# ─── PostHog (server-side events zoals order_completed) ────────────────────
POSTHOG_EVENTS_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Bootstrap (zie src/scripts/bootstrap.ts) ──────────────────────────────
# Vaste publishable key: echo pk_$(openssl rand -hex 32)
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
SEED_WAREHOUSE_CITY=Utrecht
