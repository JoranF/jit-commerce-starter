# Kopieer naar .env.local en vul in.

# Publishable key: Admin > Settings > Publishable API Keys (of MEDUSA_PUBLISHABLE_KEY uit de backend)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Publieke URL van de Medusa-backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Standaard land als het niet uit de URL te halen is
NEXT_PUBLIC_DEFAULT_REGION=nl
# Publieke URL van de winkel (canonical, JSON-LD, sitemap, UCP, Mollie-terugkeer)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# ─── PostHog (analytics + A/B-testen) ─────────────────────────────────────
# Project API key (phc_...). Leeg = geen tracking, experimenten tonen "control".
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_API_HOST=https://eu.i.posthog.com
POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com

# Docker-build: "true" voor een kleine standalone image
NEXT_OUTPUT_STANDALONE=false

# Optioneel: andere betaalproviders die de dtc-starter ondersteunt
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
