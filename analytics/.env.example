# PostHog: Settings > Personal API keys (scopes: query:read, insight:write,
# dashboard:write, experiment:write, feature_flag:write)
POSTHOG_PERSONAL_API_KEY=phx_...
# Project-ID uit de URL: eu.posthog.com/project/<ID>
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://eu.posthog.com

# Optioneel: Discord- of Slack-webhook voor rapporten
REPORT_WEBHOOK_URL=
# Optioneel: AI-testideeën in het weekrapport
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Winnaars automatisch uitrollen (alleen experimenten met autoShip: true in config.ts)
AUTO_SHIP_WINNERS=false
