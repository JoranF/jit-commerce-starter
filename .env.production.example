# Plak dit in Dokploy → je Compose-service → Environment, en vul in.
# Secrets genereren:  openssl rand -hex 32

# Publieke URL's (zonder / aan het eind)
STORE_URL=https://shop.example.nl
MEDUSA_BACKEND_URL=https://api.shop.example.nl

POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
REVALIDATE_SECRET=

# Vaste publishable key, zelf gekozen: echo pk_$(openssl rand -hex 32)
MEDUSA_PUBLISHABLE_KEY=

# Admin-account voor <MEDUSA_BACKEND_URL>/app (wordt bij eerste start aangemaakt)
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# Demo-producten bij lege database (zet op false zodra je eigen producten hebt)
SEED_DEMO=true
STORE_NAME=Mijn Webshop
DEFAULT_REGION=nl

# Mollie (leeg = alleen testbetaling). Begin met test_..., later live_...
MOLLIE_API_KEY=
MOLLIE_DESCRIPTION=Bestelling

# PostHog project key (phc_...). Leeg = geen tracking.
POSTHOG_KEY=
POSTHOG_INGEST_HOST=https://eu.i.posthog.com
POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
